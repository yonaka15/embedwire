{
  "name": "yt-follow",
  "version": "0.2.0",
  "description": "The YouTube IFrame Player API over raw postMessage — no iframe_api script, works with youtube-nocookie. playVideo/seekTo/getDuration/stateChange and the rest, plus a transcript-follow example.",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./connect": "./src/connect.js",
    "./follow": "./src/follow.js"
  },
  "files": ["src", "README.md", "LICENSE"],
  "sideEffects": false,
  "scripts": {
    "test": "node --test test/*.test.js",
    "demo": "python3 -m http.server 4330 --bind 127.0.0.1"
  },
  "keywords": ["youtube", "iframe", "postmessage", "embed", "nocookie", "transcript", "interactive-transcript", "seek", "sync"],
  "author": "yonaka15",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/yonaka15/yt-follow.git" },
  "homepage": "https://github.com/yonaka15/yt-follow#readme",
  "bugs": { "url": "https://github.com/yonaka15/yt-follow/issues" },
  "devDependencies": {
    "jsdom": "^30.0.1"
  }
